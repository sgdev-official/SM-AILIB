{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "sm-ailib": {
        "type": "local",
        "command": ["node", "<ABSOLUTE_PATH_TO_SM_AILIB_SERVER_JS>"],
        "cwd": ".",
        "environment": {
          "SM_AILIB_HOME": "<ABSOLUTE_DATA_HOME>"
        }
      }
    }
  },
  "plugins": [
    "./plugins/sm-ailib"
  ]
}
